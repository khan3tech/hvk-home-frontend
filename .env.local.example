# Copy to .env.local (git-ignored). Only NEXT_PUBLIC_* values reach the browser — never put secrets here.

# Candidate Platform API (hvk-home-backend). Runs on :4000 locally because Next.js uses :3000.
# The backend must allow this app's origin: CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Keep aligned with backend EXAM_CUTOFF_ENABLED when enabling passing rules.
NEXT_PUBLIC_EXAM_CUTOFF_ENABLED=false

# Mobile OTP sign-in tab. Off until SMS delivery is live (email + password only). Set to true to show it.
NEXT_PUBLIC_MOBILE_OTP_ENABLED=false
